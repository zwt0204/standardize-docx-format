{
  "name": "中文毕业论文通用 v2 示例",
  "requirements": {
    "sourceType": "description",
    "sources": ["用户提供的论文格式说明"],
    "unresolved": [],
    "conflicts": []
  },
  "page": {
    "size": "a4",
    "orientation": "portrait",
    "marginsIn": {
      "top": 1.0,
      "right": 1.0,
      "bottom": 1.0,
      "left": 1.25,
      "header": 0.6,
      "footer": 0.6
    }
  },
  "defaultRun": {
    "latinFont": "Times New Roman",
    "eastAsiaFont": "宋体",
    "complexScriptFont": "Times New Roman",
    "sizePt": 12,
    "updateTheme": true
  },
  "styles": {
    "Normal": {
      "name": "正文",
      "run": {
        "latinFont": "Times New Roman",
        "eastAsiaFont": "宋体",
        "complexScriptFont": "Times New Roman",
        "sizePt": 12
      },
      "paragraph": {
        "alignment": "justify",
        "lineSpacing": 1.5,
        "spaceBeforePt": 0,
        "spaceAfterPt": 0,
        "firstLineChars": 2,
        "widowControl": true
      }
    },
    "Heading1": {
      "name": "一级标题",
      "basedOn": "Normal",
      "next": "Normal",
      "run": {"latinFont": "Times New Roman", "eastAsiaFont": "黑体", "sizePt": 16, "bold": true},
      "paragraph": {"alignment": "left", "spaceBeforePt": 12, "spaceAfterPt": 12, "keepNext": true, "outlineLevel": 0}
    },
    "Heading2": {
      "name": "二级标题",
      "basedOn": "Normal",
      "next": "Normal",
      "run": {"latinFont": "Times New Roman", "eastAsiaFont": "黑体", "sizePt": 14, "bold": true},
      "paragraph": {"alignment": "left", "spaceBeforePt": 6, "spaceAfterPt": 6, "keepNext": true, "outlineLevel": 1}
    },
    "Heading3": {
      "name": "三级标题",
      "basedOn": "Normal",
      "next": "Normal",
      "run": {"latinFont": "Times New Roman", "eastAsiaFont": "宋体", "sizePt": 12},
      "paragraph": {"alignment": "left", "spaceBeforePt": 6, "spaceAfterPt": 3, "keepNext": true, "outlineLevel": 2}
    }
  },
  "pageNumbers": [
    {"section": 0, "format": "upper-roman", "start": 1},
    {"section": 1, "format": "decimal", "start": 1}
  ],
  "headingNumbering": {
    "enabled": true,
    "styles": ["Heading1", "Heading2", "Heading3"],
    "patterns": ["%1", "%1.%2", "%1.%2.%3"],
    "formats": ["decimal", "decimal", "decimal"],
    "starts": [1, 1, 1],
    "suffix": "space"
  },
  "paragraphRules": [
    {
      "match": {"textRegex": "^\\d+\\s+\\S+", "inTextBox": false},
      "style": "Heading1",
      "textRegexReplace": {"pattern": "^\\d+\\s+", "replacement": ""},
      "maxMatches": 50
    },
    {
      "match": {"textRegex": "^\\d+\\.\\d+\\s+\\S+", "inTextBox": false},
      "style": "Heading2",
      "textRegexReplace": {"pattern": "^\\d+\\.\\d+\\s+", "replacement": ""},
      "maxMatches": 100
    }
  ],
  "fieldRules": [
    {
      "placeholder": "{{TOC}}",
      "instruction": "TOC \\o \"1-2\" \\h \\u",
      "result": "目录",
      "required": false
    }
  ],
  "fields": {"updateOnOpen": true},
  "validation": {
    "requiredTexts": ["摘要", "参考文献"],
    "noPlaceholders": ["\\{\\{[^}]+\\}\\}"],
    "requiredStylesUsed": ["Normal"]
  }
}
